# Database Configuration
#
# DATABASE_PATH - Optional: Full path to SQLite database file
# For Hostinger production, set this to a persistent directory path
# Example: /home/username/.poultry_app_data/poultry.db
#
# If not set:
# - Production (NODE_ENV=production): Uses ~/.poultry_app_data/poultry.db
# - Development: Uses ./poultry.db (current directory)

DATABASE_PATH=

# Node Environment
NODE_ENV=development

# Server Port
PORT=5000
